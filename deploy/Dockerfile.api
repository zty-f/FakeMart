FROM node:22-bookworm-slim

WORKDIR /app

ENV CI=true \
  PNPM_HOME=/pnpm \
  XDG_CONFIG_HOME=/tmp/.config \
  NPM_CONFIG_UPDATE_NOTIFIER=false

RUN npm config set registry https://registry.npmmirror.com \
  && npm install -g pnpm@10.33.0

RUN mkdir -p /pnpm/store \
  && printf 'registry=https://registry.npmmirror.com\nfetch-retries=5\nfetch-retry-mintimeout=10000\nfetch-retry-maxtimeout=120000\nstore-dir=/pnpm/store\npackage-import-method=copy\nnode-linker=hoisted\n' > .npmrc

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY apps/api apps/api
COPY packages/shared packages/shared

EXPOSE 4000

WORKDIR /app/apps/api
CMD ["pnpm", "exec", "tsx", "src/server.ts"]
